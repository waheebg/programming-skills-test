.mw-parser-output .hlist dd dd:first-child::before, .mw-parser-output .hlist dd dt:first-child::before, .mw-parser-output .hlist dd li:first-child::before, .mw-parser-output .hlist dt dd:first-child::before, .mw-parser-output .hlist dt dt:first-child::before, .mw-parser-output .hlist dt li:first-child::before, .mw-parser-output .hlist li dd:first-child::before, .mw-parser-output .hlist li dt:first-child::before, .mw-parser-output .hlist li li:first-child::before { content: " ("; font-weight: normal; }

